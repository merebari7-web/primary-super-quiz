tions":["tomato","tomato's","tomatos","tomatoes"],"answer":3,"explain":"One tomato, many tomatoes."},{"q":"Choose the correct word: Yesterday she ____.","options":["walk","will walk","walked","walking"],"answer":2,"explain":"Yesterday shows the past tense: walked."}]