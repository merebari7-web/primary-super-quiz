[{"q":"The opposite of thick is ____.","options":["hate","west","thin","soft"],"answer":2,"explain":"thick and thin are antonyms."},{"q":"A synonym of begin is ____.","options":["start","quiet","unhappy","speak"],"answer":0,"explain":"begin and start mean almost the same."},{"q":"The plural of leaf is ____.","options":["leafes","leaf's","leafs","leaves"],"answer":3,"explain":"One leaf, many leaves."},{"q":"The past tense of see is ____.","options":["saw","see","sees","seeing"],"answer":0,"explain":"Today I see, yesterday I saw."},{"q":"We sit ____ our friends.","options":["very","with","froms","tall"],"answer":1,"explain":"The preposition is “with”."},{"q":"A word that describes a noun is an ____.","options":["adjective","preposition","verb","adverb"],"answer":0,"explain":"Adjectives describe nouns, e.g. a red ball."},{"q":"A word that tells us how an action is done is an ____.","options":["adjective","noun","adverb","article"],"answer":2,"explain":"Adverbs often end in -ly, e.g. quickly."},{"q":"A doing word is called a ____.","options":["noun","conjunction","adjective","verb"],"answer":3,"explain":"Verbs show action: run, jump, think."},{"q":"A naming word is called a ____.","options":["preposition","noun","adverb","verb"],"answer":1,"explain":"Nouns name people, places or things."},{"q":"Complete the simile: as cold as ____","options":["tea","ice","fire","sun"],"answer":1,"explain":"A simile compares using as or like."},{"q":"Do not ____ in the hall.","options":["white","weight","wait","wet"],"answer":2,"explain":"The correct homophone here is “wait”."},{"q":"Which word is a conjunction?","options":["happy","because","under","quickly"],"answer":1,"explain":"Conjunctions join words or sentences: and, but, because."},{"q":"“Sit down.” is an ____ sentence.","options":["imperative","noun","exclamatory","interrogative"],"answer":0,"explain":"Imperative sentences give commands."},{"q":"The prefix un- in unhappy means ____.","options":["not","before","very","again"],"answer":0,"explain":"un- = not."},{"q":"The suffix -less in hopeless means ____.","options":["full of","before","without","again"],"answer":2,"explain":"-less = without."},{"q":"Active: The cat chased the mouse. Passive: The mouse ____ by the cat.","options":["is chase","chasing","was chased","chased"],"answer":2,"explain":"Passive = be + past participle."},{"q":"The comparative of tall is ____.","options":["taller","talling","tallest","more tall"],"answer":0,"explain":"tall → taller → tallest."},{"q":"Neither of the boys ____ present.","options":["is","are","were","have"],"answer":0,"explain":"Neither is singular."},{"q":"A letter to the head teacher is a ____ letter.","options":["secret","friendly","formal","poem"],"answer":2,"explain":"Official letters are formal."},{"q":"A clause must have a subject and a ____.","options":["picture","title","comma","verb"],"answer":3,"explain":"Every clause has a subject and a verb."},{"q":"Giving human qualities to things is ____.","options":["personification","plural","simile","tense"],"answer":0,"explain":"E.g. “The wind whispered.”"},{"q":"The main idea of a passage is the ____.","options":["margin","footnote","index","theme"],"answer":3,"explain":"The theme is what the passage is mostly about."},{"q":"She said, “I am tired.” Reported: She said that she ____ tired.","options":["am","is","was","were"],"answer":2,"explain":"Present tense often becomes past in reported speech."},{"q":"In “Ada gave Chidi a book”, the indirect object is ____.","options":["Ada","book","gave","Chidi"],"answer":3,"explain":"Chidi receives the book."},{"q":"Choose the correctly punctuated sentence.","options":["Let's eat, Grandma.","Lets eat, grandma.","Let's eat Grandma.","Lets eat Grandma."],"answer":0,"explain":"Let’s = let us. The comma shows we are speaking to Grandma."},{"q":"The opposite of wide is ____.","options":["narrow","low","new","close"],"answer":0,"explain":"wide and narrow are antonyms."},{"q":"A synonym of happy is ____.","options":["clever","scared","glad","large"],"answer":2,"explain":"happy and glad mean almost the same."},{"q":"The plural of cat is ____.","options":["cates","cats","cat's","cat"],"answer":1,"explain":"One cat, many cats."},{"q":"The past tense of write is ____.","options":["wrote","write","writes","writeing"],"answer":0,"explain":"Today I write, yesterday I wrote."},{"q":"The picture hangs ____ the wall.","options":["on","because","into","in to"],"answer":0,"explain":"The preposition is “on”."},{"q":"Complete the simile: as hungry as a ____","options":["song","hunter","cloud","pillow"],"answer":1,"explain":"A simile compares using as or like."},{"q":"A ____ has a mane.","options":["horse","ours","house","hoarse"],"answer":0,"explain":"The correct homophone here is “horse”."},{"q":"A sentence that asks something is ____.","options":["interrogative","exclamatory","declarative","imperative"],"answer":0,"explain":"Interrogative sentences ask questions."},{"q":"The prefix re- in rewrite means ____.","options":["before","wrong","not","again"],"answer":3,"explain":"re- = again."},{"q":"The superlative of good is ____.","options":["goodest","gooder","more good","best"],"answer":3,"explain":"good → better → best."},{"q":"The opposite of question is ____.","options":["answer","well","night","dirty"],"answer":0,"explain":"question and answer are antonyms."},{"q":"A synonym of end is ____.","options":["finish","present","glad","cross"],"answer":0,"explain":"end and finish mean almost the same."},{"q":"The plural of dog is ____.","options":["dogs","dog's","doges","dog"],"answer":0,"explain":"One dog, many dogs."},{"q":"Choose the correct word: Yesterday she ____.","options":["took","takeing","will take","take"],"answer":0,"explain":"Yesterday shows the past tense: took."},{"q":"He lives ____ Lagos.","options":["by to","at to","on to","in"],"answer":3,"explain":"The preposition is “in”."},{"q":"“The classroom was a zoo” is a ____.","options":["comma","simile","question","metaphor"],"answer":3,"explain":"A metaphor says one thing is another."},{"q":"I have ____ hands.","options":["too","tow","two","to"],"answer":2,"explain":"The correct homophone here is “two”."},{"q":"The opposite of happy is ____.","options":["small","sad","false","weak"],"answer":1,"explain":"happy and sad are antonyms."},{"q":"A synonym of sad is ____.","options":["beautiful","unhappy","scared","fast"],"answer":1,"explain":"sad and unhappy mean almost the same."},{"q":"The plural of class is ____.","options":["classes","classs","class's","class"],"answer":0,"explain":"One class, many classes."},{"q":"The past tense of take is ____.","options":["takes","take","took","takeing"],"answer":2,"explain":"Today I take, yesterday I took."},{"q":"She walked ____ the room.","options":["happy","because","into","tall"],"answer":2,"explain":"The preposition is “into”."},{"q":"Complete the simile: as busy as a ____","options":["stone","chair","cloud","bee"],"answer":3,"explain":"A simile compares using as or like."},{"q":"Please ____ your name.","options":["write","right","white","rite"],"answer":0,"explain":"The correct homophone here is “write”."},{"q":"The opposite of first is ____.","options":["outside","enemy","last","small"],"answer":2,"explain":"first and last are antonyms."},{"q":"A synonym of ill is ____.","options":["start","glad","sick","cross"],"answer":2,"explain":"ill and sick mean almost the same."},{"q":"The plural of ox is ____.","options":["oxes","ox's","oxs","oxen"],"answer":3,"explain":"One ox, many oxen."},{"q":"Choose the correct word: Yesterday she ____.","options":["teaching","taught","teach","will teach"],"answer":1,"explain":"Yesterday shows the past tense: taught."},{"q":"The book is ____ the table.","options":["on","so","but","and"],"answer":0,"explain":"The preposition is “on”."},{"q":"Complete the simile: as brave as a ____","options":["lion","stone","mouse","leaf"],"answer":0,"explain":"A simile compares using as or like."},{"q":"They put ____ bags here.","options"